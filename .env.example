# WordPress Development Environment Variables (Example)
# 本ファイルはローカル開発・CI/CD構築用のサンプルです。

# WordPress Database
WORDPRESS_DB_HOST=127.0.0.1:3306
WORDPRESS_DB_NAME=wordpress_bizjapan
WORDPRESS_DB_USER=wp_user
WORDPRESS_DB_PASSWORD=wp_secret_password

# Site Information
WP_HOME=http://localhost:8080
WP_SITEURL=http://localhost:8080
WP_ENV=development # development | staging | production
WP_DEBUG=true
WP_DEBUG_LOG=true
WP_DEBUG_DISPLAY=false

# Memory Limit
WP_MEMORY_LIMIT=256M
WP_MAX_MEMORY_LIMIT=512M
